# ==============================================================================
# UNISPHERE — CHANAKYA UNIVERSITY AUTONOMOUS ACADEMIC PLATFORM
# Environment Configuration Template (.env.example)
# Copy this file to '.env' or '.env.local' and supply your operational secrets.
# DO NOT commit real API keys or sensitive passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
VITE_APP_NAME="UniSphere — Chanakya University"
VITE_APP_VERSION="3.0.0"
VITE_APP_URL="http://localhost:5173"
PORT=5173

# ------------------------------------------------------------------------------
# 2. FIREBASE CLOUD STORAGE & FIRESTORE INTEGRATION
# Configure these to connect UniSphere to Google Firebase / Firestore.
# If omitted, UniSphere operates seamlessly in resilient offline-first mode.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHereExample12345"
VITE_FIREBASE_AUTH_DOMAIN="chanakya-unisphere.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="chanakya-unisphere"
VITE_FIREBASE_STORAGE_BUCKET="chanakya-unisphere.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890abcdef"
VITE_FIREBASE_MEASUREMENT_ID="G-ABC123XYZ"

# ------------------------------------------------------------------------------
# 3. INSTITUTIONAL SMTP & EMAIL NOTIFICATION SERVICE
# Used for 6-digit cryptographic OTP dispatch, admission emails, and circulars.
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@chanakyauniversity.edu.in"
SMTP_PASS="your_institutional_app_specific_password"
SMTP_FROM="\"Chanakya University Directorate\" <notifications@chanakyauniversity.edu.in>"
VITE_AUTH_OTP_EXPIRY_SECONDS=600

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE & LLM APIS
# Powers Campus AI Oracle (RAG), Socratic Code Tutor, and PresentAI Viva.
# ------------------------------------------------------------------------------
VITE_GEMINI_API_KEY="AIzaSyYourGoogleGeminiApiKeyHere"
VITE_OPENAI_API_KEY="sk-your-openai-api-key-here"
VITE_ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key-here"

# ------------------------------------------------------------------------------
# 5. CODEARENA / JUDGE0 CODE EXECUTION ENGINE
# Used for Team 04 CodeArena online code submission, evaluation, and test suites.
# ------------------------------------------------------------------------------
VITE_JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
VITE_JUDGE0_API_KEY="your_rapidapi_judge0_key_here"
VITE_JUDGE0_HOST="judge0-ce.p.rapidapi.com"

# ------------------------------------------------------------------------------
# 6. DATABASE & BACKEND API (SUPABASE / POSTGRESQL / REST)
# For production persistence of student records, audit logs, and faculty dossiers.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://xyzcompany.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/unisphere_db"

# ------------------------------------------------------------------------------
# 7. SECURITY, JWT & ENCRYPTION SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET="replace_with_a_secure_random_32_character_string_minimum"
SESSION_SECRET="replace_with_another_secure_session_secret"
